.form-card
  .eyebrow Espace organisme
  %h1 Content de vous revoir
  - if devise_mapping.registerable?
    %p.sub
      Pas encore de compte ?
      = link_to "Demander un accès", new_registration_path(resource_name)

  = form_for(resource, as: resource_name, url: session_path(resource_name)) do |f|
    .field
      = f.label :email, "Adresse e-mail"
      .input-shell
        :plain
          <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 4.5C2 3.67 2.67 3 3.5 3h9c.83 0 1.5.67 1.5 1.5v7c0 .83-.67 1.5-1.5 1.5h-9C2.67 13 2 12.33 2 11.5v-7Z" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 4.5 8 8.8l5.5-4.3" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
        = f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "vous@organisme-formation.fr", required: true

    .field{data: {controller: "password-visibility"}}
      = f.label :password, "Mot de passe"
      .input-shell
        :plain
          <svg class="icon" width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="7" width="10" height="6.5" rx="1.3" stroke="currentColor" stroke-width="1.3"/><path d="M5 7V5a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        = f.password_field :password, autocomplete: "current-password", placeholder: "••••••••••", required: true, data: { password_visibility_target: "input" }
        %button.toggle-eye{type: "button", "aria-label": "Afficher le mot de passe", data: { action: "password-visibility#toggle" }}
          :plain
            <svg data-password-visibility-target="iconVisible" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1 8s2.5-5 7-5 7 5 7 5-2.5 5-7 5-7-5-7-5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><circle cx="8" cy="8" r="2" stroke="currentColor" stroke-width="1.3"/></svg>
            <svg data-password-visibility-target="iconHidden" class="d-none" width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M1.5 1.5l13 13" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><path d="M6.6 6.7a2 2 0 0 0 2.7 2.7M4 4.2C2.3 5.2 1 8 1 8s2.5 5 7 5c1.1 0 2.1-.3 2.9-.8M8 3c4.5 0 7 5 7 5s-.6 1.3-1.8 2.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>

    .row-between
      - if devise_mapping.rememberable?
        %label.checkbox
          = f.check_box :remember_me
          Se souvenir de moi
      - if devise_mapping.recoverable?
        = link_to "Mot de passe oublié ?", new_password_path(resource_name)

    %button.btn-primary{type: "submit"}
      | Se connecter
      :plain
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7H12M12 7L7.5 2.5M12 7L7.5 11.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>

  .security-note
    :plain
      <svg width="17" height="17" viewBox="0 0 16 16" fill="none"><path d="M8 1.5 13 3.5v3.7c0 3.4-2.1 5.9-5 6.8-2.9-.9-5-3.4-5-6.8V3.5L8 1.5Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/><path d="M5.7 8 7.3 9.6 10.3 6.4" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
    %p
      %b Vos identifiants restent propres à Axopia.
      Chiffrés et gérés directement par votre organisme — aucune connexion via un compte tiers (Google, Microsoft…).

  %p.foot-note
    En vous connectant, vous acceptez les
    = link_to "conditions d'utilisation", "#"
    %br
    et la
    = link_to "politique de confidentialité", "#"
    d'Axopia.
