%head
  %title
    = @title.nil? ? "Axopia" : @title
  %link{href: "https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Source+Serif+4:ital@1&family=IBM+Plex+Mono:wght@400;500&display=swap", rel: "stylesheet"}
  = csrf_meta_tags
  = csp_meta_tag
  %meta{name: "viewport", content: "width=device-width, initial-scale=1"}
  = stylesheet_link_tag "application", media: "all"
  = javascript_importmap_tags
  - favicon_path = 'favicon.png'
  = favicon_link_tag favicon_path, type: 'image/png'
  = yield :head