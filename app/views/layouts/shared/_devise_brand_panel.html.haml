.brand-panel
  .brand-mark
    :plain
      <svg width="28" height="28" viewBox="0 0 76 76" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="38" cy="38" r="36.5" stroke="#F5F5F5" stroke-width="1.5"/>
        <line x1="38" y1="14" x2="38" y2="62" stroke="#F5F5F5" stroke-width="3" stroke-linecap="round" opacity="0.85"/>
        <line x1="18" y1="52" x2="58" y2="24" stroke="#C58E3A" stroke-width="5" stroke-linecap="round"/>
        <circle cx="38" cy="38" r="4.5" fill="#F5F5F5"/>
      </svg>
    %span Axopia

  .axis-stage
    :plain
      <svg width="248" height="248" viewBox="0 0 220 220" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle cx="110" cy="110" r="98" stroke="rgba(245,245,245,0.10)" stroke-width="1" stroke-dasharray="2 6"/>
        <circle cx="110" cy="110" r="72" stroke="rgba(245,245,245,0.14)" stroke-width="1"/>
        <g class="spin">
          <circle cx="110" cy="38" r="2.5" fill="rgba(245,245,245,0.4)"/>
          <circle cx="110" cy="182" r="2.5" fill="rgba(245,245,245,0.4)"/>
          <circle cx="38" cy="110" r="2.5" fill="rgba(245,245,245,0.4)"/>
          <circle cx="182" cy="110" r="2.5" fill="rgba(245,245,245,0.4)"/>
        </g>
        <line x1="110" y1="34" x2="110" y2="186" stroke="rgba(245,245,245,0.4)" stroke-width="2" stroke-linecap="round"/>
        <g class="pulse">
          <line x1="46" y1="146" x2="174" y2="74" stroke="#C58E3A" stroke-width="6" stroke-linecap="round"/>
          <circle cx="174" cy="74" r="7" fill="#C58E3A"/>
        </g>
        <circle cx="110" cy="110" r="8" fill="#F5F5F5"/>
        <circle cx="110" cy="110" r="14" stroke="rgba(245,245,245,0.3)" stroke-width="1"/>
      </svg>

  .brand-copy
    .kicker Pilotage qualité
    %p.headline Un axe stable, un pilotage continu — la qualité de vos centres de formation, alignée.

  .brand-stats
    .stat
      %b 96%
      %small Score qualité moyen
    .stat
      %b 120+
      %small Centres accompagnés
    .stat
      %b ISO · Qualiopi
      %small Référentiels couverts
